# EAS Build Ignore — Exclude everything at repository root except mobile folder

# Ignore all root-level files and folders
/*

# Whitelist mobile app directory and its contents
!/mobile
!/mobile/**

# Whitelist root eas.json if referenced
!/eas.json

# Mobile app internal ignores (never upload node_modules or build outputs)
/mobile/node_modules
/mobile/.expo
/mobile/dist
/mobile/web-build
/mobile/android
/mobile/ios
/mobile/expo-env.d.ts
/mobile/.kotlin
/mobile/*.orig.*
/mobile/*.jks
/mobile/*.p8
/mobile/*.p12
/mobile/*.key
/mobile/*.mobileprovision
/mobile/.metro-health-check*
/mobile/npm-debug.*
/mobile/yarn-debug.*
/mobile/yarn-error.*
/mobile/.DS_Store
/mobile/*.pem
/mobile/.env*.local
/mobile/*.tsbuildinfo
